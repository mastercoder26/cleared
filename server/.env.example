# Copy to .env and fill in. The app runs fine in demo mode with none of this set.

PORT=8787
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-something-random

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# platform.claude.com > API keys
ANTHROPIC_API_KEY=
